# Copy to .env in the repository root on the server and fill in. Never commit .env.

# Moderation of shared intentions, and the /dashboard password. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Hostnames allowed to reach /mcp (DNS-rebinding protection).
MCP_ALLOWED_HOSTS=approximategrace.church,www.approximategrace.church

# The resident choir (0 to disable, up to 20).
CHOIR_SIZE=15

# Cloudflare R2, for Litestream backups (R2 > Manage API tokens).
R2_ACCOUNT_ID=
R2_BUCKET=approximate-grace-db
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
